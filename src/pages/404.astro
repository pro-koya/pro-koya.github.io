---
import Base from "../layouts/Base.astro";
import Roof from "../components/Roof.astro";
---
<Base title="ページが見つかりません" description="お探しのページは見つかりませんでした。">
  <section class="section notfound">
    <div class="container narrow">
      <Roof class="roof--center" width={72} />
      <p class="code">404</p>
      <h1 class="display">ページが見つかりませんでした。</h1>
      <p>お探しのページは、移動または削除された可能性があります。</p>
      <div class="actions">
        <a href="/" class="btn btn--primary">トップへ戻る<span class="arrow">→</span></a>
        <a href="/contact" class="btn btn--ghost">相談する</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .notfound { text-align: center; padding-block: clamp(5rem, 14vh, 9rem); display: flex; flex-direction: column; align-items: center; }
  .notfound .roof { color: var(--brand); }
  .code { font-family: var(--font-round); font-size: clamp(3rem, 9vw, 5rem); color: var(--brand); letter-spacing: 0.1em; margin: 1rem 0 0.4rem; }
  .notfound p { margin-top: 0.8rem; }
  .actions { display: flex; gap: 1rem; margin-top: 2rem; flex-wrap: wrap; justify-content: center; }
</style>
